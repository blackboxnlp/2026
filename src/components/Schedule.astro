---
import Subtitle from '@/components/mdx/Subtitle.astro';
import { marked } from 'marked';
import type { PosterSessionTable } from '@/config/poster_sessions';

interface Props {
  events: Array<{
    start_time: string;
    end_time: string;
    description: string;
    papers: Array<{ title: string; authors: string }> | undefined;
    poster_table?: PosterSessionTable;
  }>;
}

const { events } = Astro.props as Props;

// Guard against the CSV and the program drifting apart (poster_sessions.ts is generated).
for (const event of events ?? []) {
  const table = event.poster_table;
  if (table && (table.start_time !== event.start_time || table.end_time !== event.end_time)) {
    console.warn(
      `Schedule: poster list for "${event.description}" (${event.start_time}-${event.end_time}) was assigned to ${table.start_time}-${table.end_time}. Re-run "npm run posters" or move it to the right program item.`,
    );
  }
}

const safeMarkedParse = (text: string | null | undefined): string => {
  try {
    return marked.parse(text || '', { mangle: false, headerIds: false });
  } catch (e) {
    console.error("Markdown parsing error:", e);
    return text || '';
  }
}
---

<Subtitle>Program</Subtitle>

{events && events.length > 0 ? (
  <div class="schedule-container bg-white text-gray-900 p-6 rounded-lg shadow-sm border border-gray-200">
    <div> {/* Adds vertical space between event blocks */}
      {events.map((event, index) => (
        <div
          class:list={[
            "event-item flex flex-col sm:flex-row", // Stack on small screens, row on larger
            "py-4", // Vertical padding
            index < events.length - 1 ? "border-b border-gray-200" : "" // Bottom border except for the last item
          ]}
        >
          {/* Time Column */}
          <div class="time-column w-full sm:w-28 md:w-32 flex-shrink-0 mb-2 sm:mb-0 sm:pr-6 text-left sm:text-right">
            <p class="text-sm font-semibold text-gray-700 whitespace-nowrap">
              {event.start_time} – {event.end_time}
            </p>
          </div>

          {/* Details Column */}
          <div class="details-column flex-grow sm:pl-6 sm:border-l border-gray-200">
            {/* Description */}
            <div
              class="max-w-none text-gray-800"
              set:html={safeMarkedParse(event.description)}
            />

            {/* Papers List (conditionally rendered) */}
            {event.papers && event.papers.length > 0 && event.papers.map((paper) => (
              <div class="paper-item pt-4">
                  <span
                  class="paper-title text-gray-900"
                  set:html={safeMarkedParse(paper.title)}
                  />
                  <span
                  class="paper-authors text-gray-600"
                  set:html={safeMarkedParse(paper.authors)}
                  />
              </div>
            ))}

            {/* Collapsible poster list (closed by default) */}
            {event.poster_table && event.poster_table.posters.length > 0 && (
              <details class="poster-table mt-4 rounded-lg border border-gray-200 bg-white">
                <summary
                  class="flex cursor-pointer select-none items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50"
                  title={`${event.poster_table.source} (estimated ${event.poster_table.start_time}-${event.poster_table.end_time})`}
                >
                  <span class="flex flex-wrap items-baseline gap-x-2">
                    <span class="text-sm font-medium text-gray-700">{event.poster_table.summary}</span>
                    <span class="hidden text-xs text-gray-400 sm:inline">Click to expand</span>
                  </span>
                  <svg class="chevron h-4 w-4 flex-shrink-0 text-gray-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      d="M14.707 6.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L10 9.586l3.293-3.293a1 1 0 011.414 0z"
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <div class="max-h-[70vh] overflow-auto border-t border-gray-200">
                  <table class="w-full border-collapse text-left align-top text-sm">
                    <thead class="sticky top-0 z-10 bg-white text-xs font-semibold uppercase tracking-wide text-gray-500 shadow-[inset_0_-1px_0_rgba(0,0,0,0.08)]">
                      <tr>
                        <th class="min-w-64 px-4 py-2">Title</th>
                        <th class="min-w-40 px-4 py-2">Authors</th>
                        <th class="px-4 py-2" title="OpenReview paper ID and track"># / Track</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                      {event.poster_table.posters.map((poster) => (
                        <tr class="hover:bg-blue-50/50">
                          <td class="px-4 py-2 font-medium text-gray-900">{poster.title}</td>
                          <td class="px-4 py-2 text-gray-600">{poster.authors}</td>
                          <td class="whitespace-nowrap px-4 py-2 text-gray-500">
                            <p class="tabular-nums">#{poster.id}</p>
                            <p class="text-xs">{poster.track}</p>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
) : (
  <p class="text-gray-600 py-8">
    <em>Program under construction, stay tuned!</em>
  </p>
)}

<style>
  .poster-table > summary {
    list-style: none; /* hide the default disclosure triangle */
  }
  .poster-table > summary::-webkit-details-marker {
    display: none;
  }
  .poster-table .chevron {
    transition: transform 150ms ease-in-out;
  }
  .poster-table[open] .chevron {
    transform: rotate(180deg);
  }
  /* Printing or copying the schedule should never be limited by the scroll box. */
  @media print {
    .poster-table > div {
      max-height: none;
      overflow: visible;
    }
    .poster-table:not([open]) > summary::after {
      content: ' (collapsed - expand to print)';
    }
  }
</style>