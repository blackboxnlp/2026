---
// One paper abstract with LaTeX math and Markdown rendered properly.
import 'katex/dist/katex.min.css';
import { renderRichText } from '@/utils/rich_text';

interface Props {
  text?: string;
  class?: string;
}

const { text, class: className = '' } = Astro.props;
const html = renderRichText(text);
---

{html !== '' && <div class={`abstract-rich ${className}`} set:html={html} />}

<style is:global>
  .abstract-rich p {
    margin: 0 0 0.6em;
  }
  .abstract-rich > p:last-child {
    margin-bottom: 0;
  }
  /* KaTeX defaults to ~1.21em, which looks oversized inside body copy. */
  .abstract-rich .katex {
    font-size: 1.04em;
  }
  /* Display formulas keep the left margin of the surrounding prose and scroll
     instead of overflowing the panel when a formula is wide. */
  .abstract-rich .katex-display {
    margin: 0.6em 0;
    text-align: left;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .abstract-rich code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92em;
    background: rgb(244 244 245);
    padding: 0.05em 0.3em;
    border-radius: 0.25rem;
  }
</style>
